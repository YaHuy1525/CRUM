{
  "name": "@allrounder/crum",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Conversational CRM workbench on Mastra with a governance plane",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "dev:mastra": "mastra dev",
    "dev:console": "cd console && npm run dev",
    "build": "mastra build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:policy": "vitest run tests/governance",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "db:export-schema": "tsx scripts/db-export-schema.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "eval:seed": "tsx scripts/eval-seed.ts",
    "eval:run": "vitest run tests/evals/golden-gate.test.ts --reporter=verbose",
    "verify": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.101",
    "@ai-sdk/typesafe-ai": "3.0.24",
    "@mastra/ai-sdk": "1.11.2",
    "@mastra/core": "1.79.0",
    "@mastra/evals": "1.10.8",
    "@mastra/mcp": "2.5.0",
    "@mastra/memory": "1.39.0",
    "@mastra/observability": "1.21.0",
    "@mastra/pg": "1.32.0",
    "@mastra/rag": "2.7.0",
    "ai": "7.0.150",
    "hono": "4.13.13",
    "pg": "8.23.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "9.39.5",
    "mastra": "1.35.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
