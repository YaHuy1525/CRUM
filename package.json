{
  "name": "@allrounder/crum",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Conversational CRM workbench on Mastra with a governance plane",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "dev:mastra": "mastra dev",
    "dev:api": "tsx watch --env-file-if-exists=.env src/api/serve.ts",
    "dev:all": "tsx scripts/dev-all.ts",
    "dev:console": "cd console && npm run dev",
    "build": "mastra build",
    "start": "mastra start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:policy": "vitest run tests/governance",
    "test:integration": "vitest run --project integration",
    "coverage": "vitest run --coverage",
    "db:export-schema": "tsx scripts/db-export-schema.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "prospects:import": "tsx --env-file-if-exists=.env scripts/prospects-import.ts",
    "prospects:score": "tsx --env-file-if-exists=.env scripts/prospects-score.ts",
    "prospects:enrich": "tsx --env-file-if-exists=.env scripts/prospects-enrich.ts",
    "mail:watch": "tsx scripts/mail-watch.ts",
    "cal:seed": "tsx --env-file-if-exists=.env scripts/calendar-seed.ts",
    "eval:seed": "tsx scripts/eval-seed.ts",
    "sim:seed": "tsx --env-file=.env scripts/sim-seed.ts",
    "fixtures:docs": "tsx scripts/doc-fixtures.ts",
    "eval:run": "vitest run tests/evals/golden-gate.test.ts --reporter=verbose",
    "test:load": "vitest run tests/load --reporter=verbose",
    "verify": "npm run typecheck && npm run lint && npm run test",
    "docker:up": "docker compose --env-file .env.compose up --build -d",
    "docker:down": "docker compose --env-file .env.compose down",
    "docker:logs": "docker compose --env-file .env.compose logs -f"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.101",
    "@ai-sdk/typesafe-ai": "3.0.24",
    "@hono/node-server": "1.19.17",
    "@mastra/ai-sdk": "1.11.2",
    "@mastra/core": "1.79.0",
    "@mastra/evals": "1.10.8",
    "@mastra/mcp": "2.5.0",
    "@mastra/memory": "1.39.0",
    "@mastra/observability": "1.21.0",
    "@mastra/pg": "1.32.0",
    "@mastra/rag": "2.7.0",
    "ai": "7.0.150",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "mammoth": "1.13.0",
    "pg": "8.23.1",
    "unpdf": "1.9.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pdfkit": "0.17.7",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "3.2.7",
    "autocannon": "7.15.0",
    "docx": "9.14.0",
    "eslint": "9.39.5",
    "mastra": "1.35.0",
    "pdfkit": "0.20.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "3.2.7"
  }
}
