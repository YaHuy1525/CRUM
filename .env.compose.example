# Compose interpolation values. Copy to .env.compose and fill.
#
# These are read by `docker compose --env-file .env.compose` to substitute the
# ${VAR} references in docker-compose.yml. They are NOT the app's runtime .env;
# the containers get their runtime config from the Compose `environment:` blocks.
#
# Why a separate file: the project .env is the developer's own and Compose would
# otherwise auto-parse it for interpolation. Keep secrets here, out of git.

# Needed only for a live chat turn. Absent, every plane still boots; a model call
# in a conversation is what fails, not the stack.
OPENROUTER_API_KEY=
CRUM_MODEL_MAIN=
CRUM_MODEL_LIGHT=
EMBEDDING_MODEL_ID=

# Dev-only signing fallbacks. docker-compose.yml has placeholders so the planes
# boot without these; set your own >= 32-byte values for anything real.
APPROVAL_HMAC_SECRET=
MCP_REQUEST_STATE_KEY=

# Browser Supabase identity for the console. Empty is fine for the dev-header
# auth path; set them to exercise the Supabase sign-in UI.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
